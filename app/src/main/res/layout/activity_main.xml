<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:padding="10dp"
            android:text="Статус: Адаптер CH340 не подключен"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerModule"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="#2C2C2C" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#1976D2"
                android:text="Подключить"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEcuInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:text="ЭБУ: не определен"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <!-- Основные кнопки как в Вася Диагност -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReadDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#388E3C"
                android:text="02 - Ошибки"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnClearDtc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="05 - Очистить"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Группы измерений 08 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="08 - Измерения (группы 001 - 255):"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGroup"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="#2C2C2C"
                android:gravity="center"
                android:hint="001"
                android:inputType="number"
                android:maxLength="3"
                android:text="001"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575" />

            <Button
                android:id="@+id/btnReadGroup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#00796B"
                android:text="Читать группу"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnBasic060"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F57C00"
                android:text="Адапт. 060"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 4 окна измерений VAG-COM -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:rowCount="2">

            <TextView
                android:id="@+id/tvCell1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:background="#263238"
                android:gravity="center"
                android:text="Окно 1\n---"
                android:textColor="#80CBC4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCell2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:background="#263238"
                android:gravity="center"
                android:text="Окно 2\n---"
                android:textColor="#80CBC4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCell3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:background="#263238"
                android:gravity="center"
                android:text="Окно 3\n---"
                android:textColor="#80CBC4"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCell4"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:background="#263238"
                android:gravity="center"
                android:text="Окно 4\n---"
                android:textColor="#80CBC4"
                android:textSize="13sp" />
        </GridLayout>

        <!-- Вывод ошибок и логов -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Результат диагностики и лог K-Line:"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:background="#000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:text="Ожидание подключения к Passat B5+...\n"
            android:textColor="#00E676"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
